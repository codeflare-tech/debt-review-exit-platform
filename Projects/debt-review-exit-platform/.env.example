# ============================================================
# Debt Review Exit Platform — Environment
# Copy to .env and fill in secrets before running.
# NEVER commit .env (already in .gitignore).
# ============================================================

# --- Database ---
# PostgreSQL 18 running on localhost:5433 (cluster 18/main).
# Create as: sudo -u postgres psql -c "CREATE DATABASE debtreview; CREATE USER debtuser WITH PASSWORD 'debtpass'; GRANT ALL ON DATABASE debtreview TO debtuser;"
DATABASE_URL="postgresql://debtuser:debtpass@localhost:5433/debtreview?schema=public"

# --- Application ---
# The host the app is served on (http for local dev; use https for production).
APP_ORIGIN=http://localhost:3000
# Secret used to sign session / CSRF tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_64_RANDOM_CHARS
# Per-request CSRF token seed (optional; SameSite=Lax cookies give baseline CSRF protection).
CSRF_SECRET=CHANGE_ME

# --- Feature flags (review before enabling) ---
# Legal approval for the live payment release workflow: set true ONLY after
# South African legal counsel approves the fee-disclosure/completion workflow.
PAYMENT_WORKFLOW_APPROVED=false
# Enable optional two-factor authentication prompts.
TWO_FACTOR_ENABLED=false

# --- Email (inbound) ---
# Atomic Mail JMAP inbox watch for client enquiries (see .env.example for real values).
ATOMICMAIL_EMAIL=hermes-local@atomicmail.ai
ATOMICMAIL_API_KEY=CHANGE_ME

# --- Document storage ---
# Files are stored PRIVATE on the server (see uploads/). Signed download links
# are short-lived (15 min) and single-use. Override for production object storage.
UPLOADS_DIR=./uploads
UPLOAD_MAX_BYTES=26214400

# --- Document malware scanning (optional, interface only) ---
# Scan uploads for malware. Leave blank to skip; set a scanner path when required.
MALWARE_SCANNER=
